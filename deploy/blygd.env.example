# /etc/blygd/blygd.env — mode 0640, owner root:blygd
# Peer auth over the unix socket: no password to leak or rotate.
BLYGD_DATABASE_URL=postgres:///blygd?host=/var/run/postgresql
BLYGD_PUBLIC_URL=https://blyg.example/
BLYGD_LISTEN=127.0.0.1:8080
# Caddy appends X-Forwarded-For; safe only because blygd listens on loopback.
BLYGD_TRUST_PROXY=true
